{
  "name": "platypad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An offline scratchpad with a live markdown preview.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "prettier": "3.9.6",
    "sass": "1.103.1",
    "typescript": "7.0.2",
    "vite": "7.1.8",
    "vitest": "4.1.11"
  }
}
